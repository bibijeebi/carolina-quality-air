---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCallBar from "../components/MobileCallBar.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  /** Set false on the homepage, where the title stands alone. */
  suffixTitle?: boolean;
}

const {
  title,
  description = "NADCA-certified air duct cleaning across Eastern North Carolina. Family owned since 1999, serving Greenville, the Triangle and Wilmington.",
  suffixTitle = true,
} = Astro.props;

const fullTitle = suffixTitle ? `${title} | ${site.name}` : title;
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://carolina-quality-air.pages.dev",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    {
      /*
      The site stays out of search until Carolina Quality Air takes it over.
      A polished clone competing with their real .com would split their local
      SEO and help nobody. Remove this block (and public/robots.txt) at handoff.
    */
    }
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0072bb" />

    {/* Self-hosted variable font: no third-party connection, no FOIT. */}
    <link
      rel="preload"
      href="/fonts/archivo-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Structured data: one HVACBusiness entity, HQ address, all offices
        as contact points. Facts limited to what the company publishes. */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "HVACBusiness",
        "@id": "https://carolinaqualityair.xyz/#business",
        name: site.name,
        url: "https://carolinaqualityair.xyz/",
        email: site.email,
        telephone: "+1-252-321-7447",
        foundingDate: "1999",
        description:
          "Family-owned, NADCA-certified air duct and dryer vent cleaning serving Eastern North Carolina since 1999.",
        address: {
          "@type": "PostalAddress",
          streetAddress: "111 Essex Dr",
          addressLocality: "Winterville",
          addressRegion: "NC",
          postalCode: "28590",
          addressCountry: "US",
        },
        contactPoint: site.offices.map((o) => ({
          "@type": "ContactPoint",
          contactType: "customer service",
          telephone: "+1-" + o.phone,
          areaServed: o.name,
        })),
        areaServed: [
          "Greenville NC",
          "Winterville NC",
          "Raleigh NC",
          "Cary NC",
          "Wilmington NC",
          "Eastern North Carolina",
        ],
        memberOf: {
          "@type": "Organization",
          name: "National Air Duct Cleaners Association",
          url: "https://nadca.com",
        },
        sameAs: [
          "https://www.facebook.com/hvaccleaning/",
          "https://www.youtube.com/channel/UCytmEca5Hpr3XmVKTHF62Hg",
        ],
      })}
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-ink focus:px-4 focus:py-3 focus:text-paper"
    >
      Skip to content
    </a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
