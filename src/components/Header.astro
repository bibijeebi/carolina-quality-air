---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo-cqa.png";
import { site } from "../data/site";

const nav = [
  { href: "/services", label: "Services" },
  { href: "/service-areas", label: "Service areas" },
  { href: "/proof", label: "Our work" },
  { href: "/nadca", label: "Certification" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

{/* Utility strip — the small signal that this is a licensed trade business. */}
<div class="hidden bg-ink text-paper lg:block">
  <div
    class="mx-auto flex max-w-[80rem] items-center justify-between px-8 py-2 text-[0.7rem] tracking-[0.1em] uppercase"
  >
    <p class="text-mist">
      NADCA member since {site.nadcaMemberSince} &middot; Family owned since {
        site.founded
      }
    </p>
    <div class="flex items-center gap-6 text-mist">
      <a href={`mailto:${site.email}`} class="link-slide hover:text-paper">
        {site.email}
      </a>
      {
        site.offices.map((o) => (
          <a
            href={o.phoneHref}
            class="link-slide tnum hover:text-paper"
            aria-label={`Call the ${o.name} office`}
          >
            <span class="text-brand-300">{o.name.split(" / ")[0]}</span>{" "}
            {o.phone}
          </a>
        ))
      }
    </div>
  </div>
</div>

<header
  class="sticky top-0 z-50 border-b border-hairline bg-paper/92 backdrop-blur-md"
>
  <div class="mx-auto max-w-[80rem] px-5 sm:px-8">
    <div class="flex h-[4.5rem] items-center justify-between gap-8">
      <a href="/" class="shrink-0" aria-label={`${site.name} — home`}>
        <Image
          src={logo}
          alt={site.name}
          widths={[240, 366]}
          sizes="200px"
          class="h-9 w-auto sm:h-10"
          loading="eager"
        />
      </a>

      <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
        {
          nav.map((l) => (
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class:list={[
                "link-slide text-[0.9rem] font-medium transition-colors",
                isActive(l.href)
                  ? "text-brand-700"
                  : "text-ink-2 hover:text-brand-700",
              ]}
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={site.phone.href}
          class="tnum hidden items-center gap-2 text-[0.95rem] font-semibold text-ink md:inline-flex"
        >
          <svg
            class="size-4 text-brand-600"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 0 1 2-2h3.3a1 1 0 0 1 .95.68l1.5 4.5a1 1 0 0 1-.5 1.2l-2.26 1.13a11 11 0 0 0 5.5 5.5l1.13-2.25a1 1 0 0 1 1.2-.5l4.5 1.5a1 1 0 0 1 .68.94V19a2 2 0 0 1-2 2h-1C9.7 21 3 14.3 3 6Z"
            ></path>
          </svg>
          {site.phone.display}
        </a>

        <a
          href={site.booking.freeInspection}
          class="hidden rounded-xs bg-brand-600 px-5 py-3 text-[0.85rem] font-semibold tracking-wide text-white transition-colors hover:bg-brand-700 sm:inline-block"
        >
          Request a free inspection
        </a>

        {/* CSS-only mobile menu: <details> means no JavaScript ships. */}
        <details class="group relative lg:hidden">
          <summary
            class="flex size-11 cursor-pointer list-none items-center justify-center rounded-xs border border-hairline text-ink"
            aria-label="Open menu"
          >
            <svg
              class="size-5 group-open:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
              class="hidden size-5 group-open:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </summary>

          <div
            class="fixed inset-x-0 top-[4.5rem] max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-hairline bg-paper px-5 pb-28 pt-2 shadow-lg"
          >
            <nav aria-label="Mobile">
              {
                nav.map((l) => (
                  <a
                    href={l.href}
                    class="block border-b border-hairline py-4 font-display text-2xl text-ink"
                  >
                    {l.label}
                  </a>
                ))
              }
              <a
                href="/contact"
                class="block border-b border-hairline py-4 font-display text-2xl text-ink"
              >
                Contact
              </a>
            </nav>
            <div class="mt-6 space-y-2">
              {
                site.offices.map((o) => (
                  <a
                    href={o.phoneHref}
                    class="flex items-center justify-between py-2 text-ink-2"
                  >
                    <span class="text-sm">{o.name}</span>
                    <span class="tnum font-semibold text-brand-700">
                      {o.phone}
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
