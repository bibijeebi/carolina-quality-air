---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import nadca from "../assets/brand/nadca-logo.png";
import { site } from "../data/site";

const year = new Date().getFullYear();

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
const areas = (await getCollection("areas")).sort(
  (a, b) => a.data.order - b.data.order,
);

const company = [
  { href: "/about", label: "About us" },
  { href: "/nadca", label: "NADCA certification" },
  { href: "/proof", label: "Before & after" },
  { href: "/testimonials", label: "Reviews" },
  { href: "/faq", label: "Questions" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="relative overflow-hidden bg-ink text-paper grain">
  <div class="relative z-10 mx-auto max-w-[80rem] px-5 py-20 sm:px-8 sm:py-24">
    <div class="grid gap-14 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <p
          class="font-display text-3xl leading-[1.1] tracking-tight text-paper"
        >
          Cleaning up indoor air<br />across Eastern NC.
        </p>
        <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed text-mist">
          Family owned since {site.founded}. A NADCA member company serving
          Eastern North Carolina — and one that helps train and certify other
          duct cleaners across the country.
        </p>

        <div class="mt-8 flex items-center gap-4">
          <Image
            src={nadca}
            alt="NADCA — National Air Duct Cleaners Association member"
            widths={[120, 240]}
            sizes="72px"
            class="h-16 w-auto rounded-xs bg-paper p-1.5"
          />
          <div class="text-[0.8rem] leading-snug text-mist">
            <span class="block font-semibold text-paper">NADCA member</span>
            An ASCS-certified specialist<br />on site for every job
          </div>
        </div>
      </div>

      <div>
        <h2 class="eyebrow eyebrow-plain mb-5 text-mist">Services</h2>
        <ul class="space-y-3">
          {
            services.map((s) => (
              <li>
                <a
                  href={`/services/${s.id}`}
                  class="link-slide text-[0.95rem] text-paper/80 hover:text-paper"
                >
                  {s.data.navLabel}
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="eyebrow eyebrow-plain mb-5 mt-10 text-mist">Areas</h2>
        <ul class="space-y-3">
          {
            areas.map((a) => (
              <li>
                <a
                  href={`/service-areas/${a.id}`}
                  class="link-slide text-[0.95rem] text-paper/80 hover:text-paper"
                >
                  {a.data.city}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="eyebrow eyebrow-plain mb-5 text-mist">Company</h2>
        <ul class="space-y-3">
          {
            company.map((c) => (
              <li>
                <a
                  href={c.href}
                  class="link-slide text-[0.95rem] text-paper/80 hover:text-paper"
                >
                  {c.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="eyebrow eyebrow-plain mb-5 text-mist">Offices</h2>
        <div class="space-y-6">
          {
            site.offices.map((o) => (
              <div>
                <p class="text-[0.95rem] font-semibold text-paper">{o.name}</p>
                <p class="mt-1 text-[0.85rem] leading-snug text-mist">
                  {o.street}
                  <br />
                  {o.city}
                </p>
                <a
                  href={o.phoneHref}
                  class="tnum mt-1.5 inline-block font-semibold text-brand-300 hover:text-brand-200"
                >
                  {o.phone}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="rule-dark mt-16 flex flex-col gap-4 pt-8 text-[0.8rem] text-mist sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <a
        href={`mailto:${site.email}`}
        class="link-slide hover:text-paper">{site.email}</a
      >
    </div>
  </div>
</footer>
