---
interface Props {
  name: "home" | "building" | "factory" | "medical" | "dryer";
  class?: string;
}

const { name, class: className = "size-6" } = Astro.props;

/**
 * Hand-drawn line paths rather than a generic icon set — the stock
 * Heroicons house/office/heart trio is one of the loudest "template" tells.
 */
const paths: Record<Props["name"], string[]> = {
  home: ["M3 11.2 12 4l9 7.2", "M5.6 9.6V20h12.8V9.6", "M10 20v-5h4v5"],
  building: [
    "M4 20V5.4A1.4 1.4 0 0 1 5.4 4h8.2A1.4 1.4 0 0 1 15 5.4V20",
    "M15 10h3.6A1.4 1.4 0 0 1 20 11.4V20",
    "M2.5 20h19",
    "M7.5 8h4M7.5 12h4M7.5 16h4",
  ],
  factory: [
    "M3 20V11l5.5 3.4V11L14 14.4V7.6L20.5 11v9",
    "M2 20h20",
    "M17 4.5h3l.5 3.4",
  ],
  medical: [
    "M4.5 20V6.6A1.6 1.6 0 0 1 6.1 5h11.8a1.6 1.6 0 0 1 1.6 1.6V20",
    "M2.8 20h18.4",
    "M12 8.8v5M9.5 11.3h5",
  ],
  dryer: [
    "M4.5 20V5.5A1.5 1.5 0 0 1 6 4h12a1.5 1.5 0 0 1 1.5 1.5V20",
    "M2.8 20h18.4",
    "M12 15.6a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8Z",
    "M7.2 6.6h1.4",
  ],
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
