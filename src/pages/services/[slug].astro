---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CallToAction from "../../components/CallToAction.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"services">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const others = (await getCollection("services"))
  .filter((s) => s.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);

const bookingUrl = d.bookingUrl ?? site.booking.freeEstimate;
// Our own photos, one per service where one fits (dryer vent has none of its own yet, so it gets none).
import { Image } from "astro:assets";
import Airflow from "../../components/Airflow.astro";
import p1 from "../../assets/work/duct-1-after.jpg";
import p3 from "../../assets/work/duct-3-after.jpg";
import p5 from "../../assets/work/duct-5-before.jpg";
import p6 from "../../assets/work/duct-6-after.jpg";
const PHOTO: Record<string, [ImageMetadata, string]> = {
  residential: [p1, "A residential supply duct after cleaning"],
  commercial: [p3, "A commercial duct run after source-removal cleaning"],
  medical: [p6, "A duct after cleaning, bare metal end to end"],
  industrial: [p5, "A duct before cleaning, its floor bedded with debris"],
};
const photo = PHOTO[entry.id];
---

<Layout title={d.title} description={d.summary}>
  <section class="grain relative overflow-hidden bg-ink text-white">
    <Airflow />
    <div class:list={["relative z-10 mx-auto grid max-w-[80rem] items-center gap-10 px-5 py-16 sm:px-8 sm:py-20", photo && "lg:grid-cols-[1.2fr_0.8fr] lg:gap-16"]}>
      <div class="rise">
        <a
          href="/services"
          class="link-slide text-[0.85rem] font-semibold text-brand-300">&larr; All services</a
        >
        <div class="mt-8 flex items-start gap-5">
          <ServiceIcon
            name={d.icon}
            class="mt-1 size-10 shrink-0 text-brand-300"
          />
          <div>
            <h1 class="max-w-[18ch] font-display text-display optical-lg text-white">
              {d.title}
            </h1>
            <p class="mt-6 max-w-2xl text-lede text-mist">{d.lede}</p>
          </div>
        </div>
      </div>
      {photo && (
        <div class="rise rise-2 hidden overflow-hidden rounded-md ring-1 ring-white/15 lg:block">
          <Image src={photo[0]} alt={photo[1]} widths={[480, 720, 960]} sizes="26rem" class="photo-warm kenburns aspect-[4/3] w-full object-cover" loading="eager" />
        </div>
      )}
    </div>
  </section>

  <div
    class="mx-auto grid max-w-[80rem] gap-14 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1fr_20rem] lg:gap-20"
  >
    <article class="prose max-w-2xl">
      <Content />
    </article>

    <aside class="lg:sticky lg:top-28 lg:self-start">
      <div class="border border-hairline bg-paper-2 p-7">
        <h2 class="eyebrow eyebrow-plain">What is included</h2>
        <ul class="mt-5 space-y-3">
          {
            d.includes.map((item) => (
              <li class="flex gap-3 text-[0.9rem] leading-snug text-ink-2">
                <svg
                  class="mt-0.5 size-4 shrink-0 text-brand-600"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 12.5 9.5 18 20 7"
                  />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-6 border border-hairline p-7">
        <h2 class="eyebrow eyebrow-plain">Usually the right call for</h2>
        <ul class="mt-5 space-y-3">
          {
            d.bestFor.map((item) => (
              <li class="flex gap-3 text-[0.9rem] leading-snug text-ink-2">
                <span class="mt-2.5 h-px w-3 shrink-0 bg-brand-400" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href={bookingUrl}
        class="mt-6 block rounded-xs bg-brand-600 px-6 py-4 text-center font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Request a free estimate
      </a>
      <a
        href={site.phone.href}
        class="tnum mt-3 block rounded-xs border border-ink/20 px-6 py-4 text-center font-semibold text-ink transition-colors hover:border-ink/50"
      >
        {site.phone.display}
      </a>
    </aside>
  </div>

  <section class="border-t border-hairline bg-paper-2">
    <div class="mx-auto max-w-[80rem] px-5 py-14 sm:px-8">
      <h2 class="eyebrow eyebrow-plain">Other services</h2>
      <div class="mt-7 flex flex-wrap gap-x-8 gap-y-4">
        {
          others.map((s) => (
            <a
              href={`/services/${s.id}`}
              class="link-slide font-display text-xl text-ink hover:text-brand-700"
            >
              {s.data.navLabel}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction />
</Layout>
