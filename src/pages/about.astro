---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CallToAction from "../components/CallToAction.astro";
import { site } from "../data/site";

import jeff from "../assets/work/jeff-bagley.jpg";
import vanFront from "../assets/work/van-front.jpg";
---

<Layout
  title="About us"
  description="Carolina Quality Air has been family owned and operated in Winterville, North Carolina since 1999. Perry and Jeff Bagley are both NADCA-certified specialists."
>
  <PageHero
    eyebrow={`Family owned since ${site.founded}`}
    title="A father, a son, and a lot of ductwork."
    lede="When you hire Carolina Quality Air you are not getting a franchise or a call centre. You are getting a family business whose owners help write and teach the standards the rest of this trade is measured against."
  />

  <section class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div class="max-w-xl">
        <h2 class="font-display text-title text-ink">How it started</h2>
        <div class="prose mt-6">
          <p>
            Perry Bagley started cleaning air ducts in Eastern North Carolina in
            1999. His son Jeff joined the business in 2005. Both are certified
            through NADCA — the National Air Duct Cleaners Association — and the
            company has been a NADCA member since {site.nadcaMemberSince}.
          </p>
          <p>
            Over that time the work has taken them into hospitals, universities,
            nursing homes, schools and industrial plants across the state, as
            well as several thousand ordinary houses. Perry is one of NADCA's
            regional coordinators for the U.S. Southeast and teaches training
            classes around the country, which means the company spends part of
            its year certifying other people's duct cleaners.
          </p>
          <p>
            The practical version of that: <strong>a NADCA-certified
            specialist is on site for every job</strong>, not just on the
            letterhead.
          </p>
        </div>
      </div>

      <div>
        <Image
          src={vanFront}
          alt="A Carolina Quality Air service van"
          widths={[520, 800]}
          sizes="(min-width: 1024px) 32rem, 92vw"
          class="photo-warm w-full rounded-sm"
          loading="eager"
        />

        <div class="mt-8 grid grid-cols-2 gap-px border border-hairline bg-hairline">
          <div class="bg-paper p-6">
            <p class="tnum font-display text-3xl text-ink">
              {site.yearsInBusiness}
            </p>
            <p class="mt-1 text-[0.85rem] text-ink-3">
              Years in business, same family
            </p>
          </div>
          <div class="bg-paper p-6">
            <p class="tnum font-display text-3xl text-ink">
              {site.stats.systemsCleaned}
            </p>
            <p class="mt-1 text-[0.85rem] text-ink-3">
              Systems cleaned, by the company's count
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── The people ───────────────────────────────────────── */}
  <section class="border-y border-hairline bg-paper-2">
    <div class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-24">
      <p class="eyebrow">Who you will be dealing with</p>
      <h2 class="mt-6 max-w-[20ch] font-display text-display text-ink">
        Two names on the certifications.
      </h2>

      <div class="mt-14 grid gap-px border border-hairline bg-hairline md:grid-cols-2">
        {
          site.team.map((person, i) => (
            <div class="bg-paper p-8 sm:p-10">
              {i === 1 && (
                <Image
                  src={jeff}
                  alt="Jeff Bagley beside a Carolina Quality Air van"
                  widths={[360, 720]}
                  sizes="(min-width: 768px) 18rem, 80vw"
                  class="photo-warm mb-7 w-full max-w-[18rem] rounded-sm"
                />
              )}
              <h3 class="font-display text-title text-ink">{person.name}</h3>
              <p class="mt-1.5 text-[0.85rem] uppercase tracking-[0.12em] text-ink-4">
                {person.role}
              </p>
              <p class="mt-5 text-[0.98rem] leading-relaxed text-ink-2">
                {person.bio}
              </p>
              <ul class="mt-6 space-y-2.5">
                {person.credentials.map((c) => (
                  <li class="flex gap-3 text-[0.88rem] leading-snug text-ink-3">
                    <span class="mt-2 h-px w-3 shrink-0 bg-brand-400" />
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── The certificate ──────────────────────────────────── */}
  <section class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow">The part nobody else does</p>
        <h2 class="mt-6 max-w-[16ch] font-display text-display text-ink">
          You get a certificate.
        </h2>
      </div>
      <div class="max-w-xl">
        <p class="text-lede text-ink-2">
          When the job is finished we hand you a NADCA certificate documenting
          that your ductwork was cleaned by a certified specialist.
        </p>
        <p class="mt-5 text-[0.98rem] leading-relaxed text-ink-2">
          Keep it with your house papers. Give it to a landlord. Hand it to a
          buyer at closing, or to your facilities file if you manage a
          building. It is a small thing that turns "they said they cleaned it"
          into a document.
        </p>
        <p class="mt-5 text-[0.98rem] leading-relaxed text-ink-2">
          Carolina Quality Air is the only company in the area that provides
          one.
        </p>
      </div>
    </div>
  </section>

  {/* ── Impersonation notice — preserved from their own site,
         but as a footnote rather than a modal that eats the screen. */}
  <section class="border-y border-hairline bg-brand-100/50">
    <div class="mx-auto flex max-w-[80rem] gap-5 px-5 py-10 sm:px-8">
      <svg
        class="mt-0.5 size-6 shrink-0 text-brand-600"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 9v4.5m0 3.5h.01M10.3 3.9 2.4 17.5a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path>
      </svg>
      <div class="max-w-2xl">
        <h2 class="font-display text-xl text-ink">
          A note about fake accounts
        </h2>
        <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-2">
          There is a social media account impersonating Carolina Quality Air and
          advertising specials. It is not us. We do not run promotions through
          social media — for an estimate, call one of the numbers on this site
          or use the contact form.
        </p>
      </div>
    </div>
  </section>

  <CallToAction />
</Layout>
