---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CallToAction from "../components/CallToAction.astro";
import { site } from "../data/site";
import nadcaLogo from "../assets/brand/nadca-logo.png";

const credentials = [
  {
    code: "ASCS",
    name: "Air Systems Cleaning Specialist",
    body: "The core NADCA credential. Held by an individual, not a company — earned by examination and kept current with continuing education. A NADCA member firm has to have one on staff. Both Perry and Jeff hold it.",
  },
  {
    code: "CVI",
    name: "Certified Ventilation Inspector",
    body: "Covers assessing and documenting the condition of a system rather than cleaning it. Jeff holds this one, which is why the inspection you get comes with an actual written assessment.",
  },
  {
    code: "ACR",
    name: "The NADCA Standard",
    body: "Not a person's credential but the document member companies agree to work to. It defines the method, the equipment specification and the way the result gets verified. The detail is further down this page.",
  },
];
---

<Layout
  title="NADCA certification"
  description="What NADCA certification actually means, what the ACR Standard requires, and how to verify any contractor's credentials yourself."
>
  <PageHero
    eyebrow="Certification"
    title="What the letters actually mean."
    lede="Every duct cleaning company says it is certified. Here is what that word is worth, what ours covers, and how to check it yourself in thirty seconds."
  />

  {/* ── What NADCA is ───────────────────────────────────── */}
  <section class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-14 lg:grid-cols-[1fr_18rem] lg:gap-20">
      <div class="max-w-2xl">
        <h2 class="font-display text-title text-ink">
          NADCA is a trade association, not a government agency
        </h2>
        <div class="prose mt-6">
          <p>
            The National Air Duct Cleaners Association was formed in 1989 as a
            non-profit association of companies that clean HVAC systems. Its
            founding purpose was to promote source removal as the only
            acceptable cleaning method and to write standards the trade could be
            held to. It publishes those standards, runs the certification exams,
            and maintains a public directory of member companies.
          </p>
          <p>
            It is worth being straight about the limits of that.
            <strong>
              NADCA membership is a trade credential, not a licence.
            </strong> No federal or state agency requires it. What it does mean
            is that a member firm has agreed to a defined standard, keeps a
            certified specialist on staff, and carries liability insurance on
            file with the association.
          </p>
          <p>
            You will also see companies advertise themselves as
            "EPA-certified." There is no such thing. The EPA's own language is
            unambiguous: it "neither establishes duct cleaning standards nor
            certifies, endorses, or approves duct cleaning companies." Anyone
            claiming otherwise is telling you something useful about
            themselves.
          </p>
        </div>
      </div>

      <div class="lg:sticky lg:top-28 lg:self-start">
        <div class="border border-hairline bg-paper-2 p-7 text-center">
          <Image
            src={nadcaLogo}
            alt="NADCA — National Air Duct Cleaners Association"
            widths={[180, 360]}
            sizes="120px"
            class="mx-auto h-24 w-auto"
          />
          <p class="mt-5 text-[0.85rem] leading-relaxed text-ink-3">
            Carolina Quality Air has been a NADCA member company since {
              site.nadcaMemberSince
            }, with listings for both the Winterville and Cary locations.
          </p>
          <a
            href="https://nadca.com/homeowners/find-a-professional/"
            rel="noopener"
            class="link-slide mt-5 inline-block text-[0.88rem] font-semibold text-brand-700"
          >
            Verify us in NADCA's directory
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── The credentials ─────────────────────────────────── */}
  <section class="border-y border-hairline bg-paper-2">
    <div class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-24">
      <p class="eyebrow">What our certification covers</p>
      <h2 class="mt-6 max-w-[20ch] font-display text-display text-ink">
        Three sets of letters, and what each one covers.
      </h2>

      <div class="mt-14 grid gap-px border border-hairline bg-hairline lg:grid-cols-3">
        {
          credentials.map((c) => (
            <div class="bg-paper p-8">
              <p class="font-display text-4xl text-brand-600">{c.code}</p>
              <h3 class="mt-3 font-display text-lg leading-snug text-ink">
                {c.name}
              </h3>
              <p class="mt-4 text-[0.92rem] leading-relaxed text-ink-3">
                {c.body}
              </p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 max-w-2xl">
        <p class="text-[0.95rem] leading-relaxed text-ink-2">
          Beyond the individual credentials, Perry Bagley serves as one of
          NADCA's regional coordinators for the U.S. Southeast and teaches
          training classes nationally. Jeff sits on a NADCA national committee.
          Part of what this company does is certify other companies' technicians.
        </p>
      </div>
    </div>
  </section>

  {/* ── The ACR standard ────────────────────────────────── */}
  <section class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">The standard itself</p>
      <h2 class="mt-6 font-display text-display text-ink">
        What ACR actually requires.
      </h2>
      <p class="mt-6 text-lede text-ink-2">
        ACR — Assessment, Cleaning and Restoration of HVAC Systems — is the
        document a NADCA member agrees to work to. These are the parts that
        change what happens in your house.
      </p>
    </div>

    <div class="mt-14 grid gap-px border border-hairline bg-hairline md:grid-cols-2">
      {
        [
          {
            t: "Continuously verified negative pressure",
            b: "The system stays under suction for the whole job, so debris travels to the collection unit rather than into the room. Not 'we hooked up a vacuum' — verified, continuously.",
          },
          {
            t: "Mechanical agitation with simultaneous collection",
            b: "Brushing and vacuuming happen together. Agitating without collection is how an amateur makes a house measurably worse than before they arrived.",
          },
          {
            t: "HEPA filtration at 99.97% at 0.3 microns",
            b: "Required where the vacuum exhausts indoors. This is the specification that separates real equipment from a shop vac with a bag in it.",
          },
          {
            t: "The whole system, not just the runs",
            b: "Supply and return, registers and grilles, the blower, the evaporator coil, the drain pan. Skipping a component recontaminates the ones you paid for.",
          },
          {
            t: "A 'visibly clean' result you can check",
            b: "Interior surfaces free of non-adhered debris, verified before the system runs again. You are entitled to a walk-through, and you should take it.",
          },
          {
            t: "Objective tests if there is a dispute",
            b: "The Surface Comparison Test and the NADCA Vacuum Test, the latter with a pass threshold of 0.75 mg per 100 cm². Arguments about quality have a referee.",
          },
        ].map((item) => (
          <div class="bg-paper p-8">
            <h3 class="font-display text-lg leading-snug text-ink">{item.t}</h3>
            <p class="mt-3 text-[0.92rem] leading-relaxed text-ink-3">
              {item.b}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── Verify anyone ───────────────────────────────────── */}
  <section class="relative overflow-hidden bg-ink text-paper grain">
    <div class="relative z-10 mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-20">
        <div>
          <p class="eyebrow text-brand-300">Check anyone, including us</p>
          <h2 class="mt-6 max-w-[18ch] font-display text-display optical-lg">
            Do not take a logo on a flyer for it.
          </h2>
        </div>
        <div class="max-w-xl">
          <p class="text-lede text-paper/75">
            NADCA warns that misuse of its logo is a known scam, and that a
            company in "pending" status is not a member. The directory is public
            and free.
          </p>
          <p class="mt-5 text-[0.95rem] leading-relaxed text-mist">
            Look up any company you are considering — us included. Confirm the
            membership is current, confirm there is a certified ASCS on staff,
            and ask for three written estimates before you commit to anything.
          </p>
          <a
            href="https://nadca.com/homeowners/find-a-professional/"
            rel="noopener"
            class="mt-7 inline-flex items-center gap-2.5 rounded-xs border border-brand-300/35 px-6 py-4 font-semibold text-paper transition-colors hover:bg-brand-900"
          >
            Open the NADCA directory
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CallToAction />
</Layout>
