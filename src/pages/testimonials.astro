---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CallToAction from "../components/CallToAction.astro";
import { getTestimonials } from "../data/getTestimonials";

const testimonials = await getTestimonials();
---

<Layout
  title="Reviews"
  description="What Carolina Quality Air customers across Eastern North Carolina say about the work."
>
  <PageHero
    eyebrow="In their words"
    title="What customers actually said."
    lede="These are reviews Carolina Quality Air has collected and published itself. Nothing here is paraphrased or composed."
  />

  <section class="mx-auto max-w-[80rem] px-5 py-16 sm:px-8 sm:py-20">
    <div class="columns-1 gap-6 lg:columns-2 [&>*]:mb-6 [&>*]:break-inside-avoid">
      {
        testimonials.map((t) => (
          <figure class="border border-hairline bg-paper-2 p-8">
            <div
              class="flex gap-1"
              role="img"
              aria-label={`${t.rating} out of 5`}
            >
              {Array.from({ length: t.rating }).map(() => (
                <svg
                  class="size-4 text-brand-500"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M10 1.6l2.35 5.1 5.55.62-4.13 3.75 1.13 5.47L10 13.8l-4.9 2.74 1.13-5.47L2.1 7.32l5.55-.62L10 1.6z" />
                </svg>
              ))}
            </div>
            <blockquote class="mt-5 text-[1rem] leading-relaxed text-ink-2">
              &ldquo;{t.text}&rdquo;
            </blockquote>
            <figcaption class="mt-6 text-[0.88rem]">
              <span class="font-semibold text-ink">{t.name}</span>
              <span class="mx-2 text-hairline">/</span>
              <span class="text-ink-3">{t.location_type}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="rule mt-12 max-w-2xl pt-8">
      <p class="text-[0.9rem] leading-relaxed text-ink-3">
        We would rather show you six real reviews than sixty invented ones. If
        you would like to speak to a customer near you before booking, ask —
        we will put you in touch with someone whose house we have actually
        been in.
      </p>
    </div>
  </section>

  <CallToAction />
</Layout>
