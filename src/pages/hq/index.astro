---
// Staff HQ: the front door for the signed-in side of the site (functions/_middleware.js gates /hq/).
// Pages are discovered from public/ at build time; src/data/hq.json adds status and notes.
import fs from "node:fs";
import path from "node:path";
import hq from "../../data/hq.json";

type Doc = { href: string; slug: string; title: string; desc: string; date: string };
const pub = path.resolve("public");
const meta = (html: string, name: string) =>
  (new RegExp(`<meta[^>]+(?:property|name)="${name}"[^>]+content="([^"]*)"`, "i").exec(html) || [])[1] || "";
const decode = (s: string) =>
  s.replace(/&amp;/g, "&").replace(/&rsquo;/g, "’").replace(/&ldquo;/g, "“").replace(/&rdquo;/g, "”").replace(/&mdash;/g, "—").replace(/&ndash;/g, "–").replace(/&quot;/g, '"').replace(/&apos;/g, "'").replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(parseInt(h, 16))).replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(+d));
function scan(dir: string, keep: (f: string) => boolean = () => true): Doc[] {
  const abs = path.join(pub, dir);
  if (!fs.existsSync(abs)) return [];
  return fs.readdirSync(abs)
    .filter((f) => f.endsWith(".html") && f !== "index.html" && keep(f))
    .map((f) => {
      const html = fs.readFileSync(path.join(abs, f), "utf8");
      if (/http-equiv="refresh"/i.test(html)) return null;
      const slug = f.replace(/\.html$/, "");
      const raw = decode((/<title>([^<]*)/i.exec(html) || [])[1] || slug).replace(/\s*·\s*Carolina Quality Air\s*$/, "");
      return { href: `/${dir}/${slug}`, slug, title: raw, desc: decode(meta(html, "og:description") || meta(html, "description")), date: (/^\d{4}-\d{2}-\d{2}/.exec(slug) || [""])[0] };
    })
    .filter(Boolean) as Doc[];
}
const byDateDesc = (a: Doc, b: Doc) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title);

const S = hq.proposals as Record<string, { status: string; note?: string }>;
const LABEL: Record<string, string> = { done: "Done", moving: "In motion", waiting: "Waiting on Jeff", parked: "Parked", dead: "Dead" };
const proposals = scan("proposals").map((d) => {
  const m = /№\s*(\d+)\s*·\s*([^·]+)/.exec(d.title);
  const st = S[d.slug] || { status: "waiting" };
  return { ...d, num: m ? m[1] : "", name: m ? m[2].trim() : d.title, status: st.status, note: st.note || "" };
}).sort((a, b) => +b.num - +a.num);
const counts = Object.keys(LABEL).map((k) => [k, proposals.filter((p) => p.status === k).length] as const).filter(([, n]) => n);
const leads = scan("leads", (f) => /^\d{4}-/.test(f)).sort(byDateDesc);
const estimates = scan("estimates");
const repairs = scan("repairs").sort(byDateDesc);
const ops = scan("operations").sort(byDateDesc);
const fmt = (d: string) => (d ? new Date(d + "T12:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric" }) : "");
const leadTitle = (t: string) => t.replace(/^Lead Report\s*(№\s*\d+)?\s*·\s*/, "").replace(/^(Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday), /, "");
const leadNum = (t: string) => (/№\s*(\d+)/.exec(t) || [])[1] || "";
const asOf = new Date(hq.asOf + "T12:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0f2233">
<title>Staff HQ · Carolina Quality Air</title>
<link rel="icon" href="/favicon.svg">
<link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin>
<style is:inline>
@font-face{font-family:"Archivo";src:url("/fonts/archivo-latin-var.woff2") format("woff2-variations");font-weight:100 900;font-stretch:62% 125%;font-display:swap}
:root{--bg:#f2f5f8;--card:#fff;--ink:#0c1722;--ink2:#44576a;--line:#dde5ec;--blue:#0072bb;--navy:#0f2233;--ok:#1f7a45;--okb:#e3f3e9;--mv:#005b96;--mvb:#dbeefb;--wt:#9a4b0b;--wtb:#fbeedf;--pk:#5b6b7b;--pkb:#e9eef2;--dd:#9b2c22;--ddb:#f9e3e0;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#0b131b;--card:#121d28;--ink:#e3eaf1;--ink2:#9db0c2;--line:#23313f;--blue:#4aa8e8;--ok:#6fd49a;--okb:#143022;--mv:#7ec4ef;--mvb:#10283a;--wt:#f2a765;--wtb:#33220f;--pk:#a8b6c3;--pkb:#1c2834;--dd:#ff8f84;--ddb:#3a1714;color-scheme:dark}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Archivo,system-ui,sans-serif}
a{color:var(--blue)}
.top{background:var(--navy);color:#fff;border-bottom:4px solid #0072bb;padding:calc(env(safe-area-inset-top,0px) + 20px) 16px 20px}
.w{max-width:1080px;margin:0 auto}
.top .w{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:end;justify-content:space-between}
.eyebrow{font-family:system-ui,-apple-system,sans-serif;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:#8cc7ee;font-weight:600}
h1{font-stretch:72%;font-weight:800;font-size:clamp(30px,6vw,44px);line-height:1;margin:6px 0 0}
.top nav{display:flex;flex-wrap:wrap;gap:6px}
.top nav a{color:#fff;text-decoration:none;font-size:13.5px;font-weight:600;padding:7px 11px;border:1px solid #2c4358;border-radius:5px}
.top nav a:hover,.top nav a:focus-visible{border-color:#8cc7ee}
main{padding:24px 16px 64px;display:grid;gap:28px}
h2{font-stretch:80%;font-weight:750;font-size:22px;margin:0 0 10px;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
h2 small{font-stretch:100%;font-weight:500;font-size:13px;color:var(--ink2)}
.watch{display:grid;gap:8px}
.watch a{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:baseline;background:var(--card);border:1px solid var(--line);border-left:4px solid #d96a15;border-radius:6px;padding:10px 14px;color:var(--ink);text-decoration:none}
.watch b{font-variant-numeric:tabular-nums;color:#d96a15;font-size:13px;white-space:nowrap}
.tally{display:flex;flex-wrap:wrap;gap:6px}
.chip{font-family:system-ui,-apple-system,sans-serif;display:inline-block;font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:3px 8px;border-radius:4px;white-space:nowrap}
.c-done{color:var(--ok);background:var(--okb)}.c-moving{color:var(--mv);background:var(--mvb)}.c-waiting{color:var(--wt);background:var(--wtb)}.c-parked{color:var(--pk);background:var(--pkb)}.c-dead{color:var(--dd);background:var(--ddb)}
.props{list-style:none;margin:0;padding:0;background:var(--card);border:1px solid var(--line);border-radius:8px}
.props li{display:grid;grid-template-columns:3.2em 1fr auto;gap:4px 14px;padding:12px 16px;border-top:1px solid var(--line);align-items:start}
.props li:first-child{border-top:0}
.num{font-stretch:75%;font-weight:800;font-size:22px;line-height:1.1;color:var(--ink2);font-variant-numeric:tabular-nums}
.props a{font-weight:700;font-size:16px;text-decoration:none;color:var(--ink)}
.props a:hover{color:var(--blue);text-decoration:underline}
.props p{margin:3px 0 0;color:var(--ink2);font-size:13.5px;max-width:75ch}
.props .note{color:var(--ink);font-weight:500}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:16px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:14px 16px}
.panel h3{font-family:system-ui,-apple-system,sans-serif;margin:0 0 8px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
.panel ul{list-style:none;margin:0;padding:0;display:grid}
.panel li{padding:8px 0;border-top:1px dashed var(--line)}
.panel li:first-child{border-top:0;padding-top:2px}
.panel a{font-weight:650;text-decoration:none}
.panel a:hover{text-decoration:underline}
.panel span{display:block;color:var(--ink2);font-size:13px}
.d{font-variant-numeric:tabular-nums;color:var(--ink2);font-size:12.5px;font-weight:600;margin-right:6px}
footer{color:var(--ink2);font-size:12.5px;padding:0 16px 40px}
@media (max-width:560px){.props li{grid-template-columns:2.4em 1fr}.props .chip{grid-column:2;justify-self:start}}
</style>
</head>
<body>
<header class="top"><div class="w">
  <div><div class="eyebrow">Carolina Quality Air · staff only</div><h1>Staff HQ</h1></div>
  <nav aria-label="Sections"><a href="#proposals">Proposals</a><a href="#reports">Reports</a><a href="#tools">Tools</a><a href="/kb/">Shop Book</a><a href="/">Public site</a><a href="/_desk/out">Sign out</a></nav>
</div></header>
<main class="w">
  <section aria-labelledby="h-watch">
    <h2 id="h-watch">On the clock</h2>
    <div class="watch">{hq.watch.map((x) => <a href={x.href}><b>{x.when === "now" ? "Now" : fmt(x.when)}</b><span>{x.what}</span></a>)}</div>
  </section>

  <section id="proposals" aria-labelledby="h-props">
    <h2 id="h-props">Proposals <small>{proposals.length} spend asks · status as of {asOf}</small></h2>
    <div class="tally" style="margin-bottom:10px">{counts.map(([k, n]) => <span class={`chip c-${k}`}>{n} {LABEL[k]}</span>)}</div>
    <ol class="props" reversed>
      {proposals.map((p) => (
        <li>
          <span class="num">{p.num}</span>
          <div><a href={p.href}>{p.name}</a>{p.note && <p class="note">{p.note}</p>}<p>{p.desc}</p></div>
          <span class={`chip c-${p.status}`}>{LABEL[p.status] || p.status}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="reports" aria-labelledby="h-rep">
    <h2 id="h-rep">Reports</h2>
    <div class="grid">
      <div class="panel"><h3>Lead reports</h3><ul>{leads.map((d) => <li><a href={d.href}><span class="d" style="display:inline">{leadNum(d.title) ? `№ ${leadNum(d.title)} · ` : ""}{fmt(d.date)}</span>{leadTitle(d.title)}</a><span>{d.desc}</span></li>)}</ul></div>
      <div class="panel"><h3>Estimates</h3><ul>{estimates.map((d) => <li><a href={d.href}>{d.title}</a><span>{d.desc}</span></li>)}</ul>
        <h3 style="margin-top:16px">Repairs</h3><ul>{repairs.map((d) => <li><a href={d.href}><span class="d" style="display:inline">{fmt(d.date)}</span>{d.title.replace(/^Repair Report\s*·\s*/, "")}</a><span>{d.desc}</span></li>)}</ul>
        <h3 style="margin-top:16px">Operations</h3><ul>{ops.map((d) => <li><a href={d.href}>{d.title}</a><span>{d.desc}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <section id="tools" aria-labelledby="h-tools">
    <h2 id="h-tools">Tools</h2>
    <div class="grid">
      {hq.tools.map((g) => (
        <div class="panel"><h3>{g.group}</h3><ul>{g.items.map((t) => <li><a href={t.href}>{t.name}</a><span>{t.desc}</span></li>)}</ul></div>
      ))}
    </div>
  </section>
</main>
<footer class="w">Signed-in staff only. Statuses live in <code>src/data/hq.json</code>; new proposals and reports show up here on their own.</footer>
</body>
</html>
