---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import CallToAction from "../components/CallToAction.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import { site } from "../data/site";
import { getTestimonials } from "../data/getTestimonials";

import vanHouse from "../assets/work/van-house.jpg";
import duct4Before from "../assets/work/duct-4-before.jpg";
import duct4After from "../assets/work/duct-4-after.jpg";
import nadcaLogo from "../assets/brand/nadca-logo.png";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
const areas = (await getCollection("areas")).sort(
  (a, b) => a.data.order - b.data.order,
);
const testimonials = await getTestimonials();
const lead = testimonials[0];

const process = [
  {
    title: "We look first",
    body: "A camera goes into the trunk line before anyone quotes you anything. You see what we see. Sometimes the honest answer is that your system does not need us yet.",
  },
  {
    title: "The system goes under suction",
    body: "An industrial negative-air vacuum connects straight to the ductwork, so everything we loosen travels into the collection unit instead of into the room you are standing in.",
  },
  {
    title: "Every surface gets agitated",
    body: "The High Velocity Air Sweeper brushes the interior walls. This is the step a shop vac cannot do, and it is the difference between removing debris and rearranging it.",
  },
  {
    title: "Registers, coil and blower",
    body: "Supply and return registers come off and get cleaned. We open the air handler, because a duct cleaning that ignores the coil and blower is treating half the system.",
  },
  {
    title: "You get it in writing",
    body: "A NADCA certificate documenting that the work was done by a certified specialist. Carolina Quality Air is the only company in the area that hands you one.",
  },
];
---

<Layout
  title="Carolina Quality Air — NADCA-certified duct cleaning in Eastern NC"
  suffixTitle={false}
  description="Family-owned, NADCA-certified air duct cleaning in Greenville, Raleigh and Wilmington. Free video inspection, source-removal cleaning, and a certificate for your records."
>
  {/* ── Hero ─────────────────────────────────────────────── */}
  <section class="relative overflow-hidden border-b border-hairline">
    <div
      class="mx-auto grid max-w-[80rem] items-center gap-12 px-5 pb-16 pt-14 sm:px-8 sm:pb-20 sm:pt-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:pb-28 lg:pt-24"
    >
      <div class="rise">
        <p class="eyebrow">
          Family owned in Winterville since {site.founded}
        </p>

        <h1
          class="mt-7 max-w-[15ch] font-display text-hero optical-lg text-ink"
        >
          The air in your house has been somewhere.
        </h1>

        <p class="mt-7 max-w-lg text-lede text-ink-2">
          Carolina Quality Air has been cleaning ductwork across Eastern North
          Carolina for {site.yearsInBusiness} years — homes, hospitals,
          universities and plants. NADCA-certified, and a certified specialist
          is on site for every single job.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.booking.freeInspection}
            class="inline-flex items-center justify-center gap-2.5 rounded-xs bg-clay-600 px-7 py-4 font-semibold text-white transition-colors hover:bg-clay-700"
          >
            Book a free inspection
          </a>
          <a
            href={site.phone.href}
            class="tnum inline-flex items-center justify-center gap-2.5 rounded-xs border border-ink/20 px-7 py-4 font-semibold text-ink transition-colors hover:border-ink/50 hover:bg-paper-2"
          >
            <svg
              class="size-4 text-brand-600"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5a2 2 0 0 1 2-2h3.3a1 1 0 0 1 .95.68l1.5 4.5a1 1 0 0 1-.5 1.2l-2.26 1.13a11 11 0 0 0 5.5 5.5l1.13-2.25a1 1 0 0 1 1.2-.5l4.5 1.5a1 1 0 0 1 .68.94V19a2 2 0 0 1-2 2h-1C9.7 21 3 14.3 3 6Z"
              ></path>
            </svg>
            {site.phone.display}
          </a>
        </div>

        <p class="mt-6 text-[0.85rem] text-ink-3">
          Free written estimates &middot; Bonded and insured &middot; Greenville,
          the Triangle &amp; Wilmington
        </p>
      </div>

      <div class="rise rise-2 relative">
        <Image
          src={vanHouse}
          alt="Two Carolina Quality Air vans parked at a customer's home with equipment running"
          widths={[560, 800, 1120]}
          sizes="(min-width: 1024px) 34rem, 92vw"
          class="photo-warm w-full rounded-sm"
          loading="eager"
          fetchpriority="high"
        />

        <div
          class="absolute -bottom-6 -left-4 hidden max-w-[15rem] rounded-sm border border-hairline bg-paper p-5 shadow-xl sm:block"
        >
          <Image
            src={nadcaLogo}
            alt=""
            widths={[96, 192]}
            sizes="48px"
            class="h-12 w-auto"
          />
          <p class="mt-3 text-[0.8rem] font-semibold leading-snug text-ink">
            NADCA member since {site.nadcaMemberSince}
          </p>
          <p class="mt-1 text-[0.78rem] leading-snug text-ink-3">
            Perry Bagley is a NADCA regional coordinator for the U.S. Southeast.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Credential strip ─────────────────────────────────── */}
  <section class="border-b border-hairline bg-paper-2">
    <div
      class="mx-auto grid max-w-[80rem] divide-y divide-hairline px-5 sm:px-8 md:grid-cols-3 md:divide-x md:divide-y-0"
    >
      {
        [
          {
            k: "Since 1999",
            v: "Family owned and operated, still run by the Bagleys.",
          },
          {
            k: "Source removal",
            v: "The cleaning method NADCA's ACR Standard requires.",
          },
          {
            k: "Certificate issued",
            v: "The only company in the area that documents the work this way.",
          },
        ].map((item) => (
          <div class="py-7 md:px-8 md:first:pl-0 md:last:pr-0">
            <p class="font-display text-xl text-ink">{item.k}</p>
            <p class="mt-1.5 text-[0.9rem] leading-relaxed text-ink-3">
              {item.v}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── Proof: the before/after ──────────────────────────── */}
  <section class="mx-auto max-w-[80rem] px-5 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">Our results</p>
        <h2 class="mt-6 max-w-[14ch] font-display text-display text-ink">
          Drag it. This is a real house.
        </h2>
        <p class="mt-6 max-w-md text-lede text-ink-2">
          Same duct, same camera position, about four hours apart. Every photo
          in our gallery was taken by our own crew on our own jobs — no stock
          images, no other company's work.
        </p>
        <a
          href="/proof"
          class="link-slide mt-7 inline-flex items-center gap-2 font-semibold text-brand-700"
        >
          See the full gallery
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14m-6-6 6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <BeforeAfter
        before={duct4Before}
        after={duct4After}
        alt="a residential supply trunk line before and after source-removal cleaning"
        caption="Residential supply trunk. The layer on the floor of the duct is settled dust, fibreglass and household debris — everything the system had been pushing back into the house."
        start={58}
      />
    </div>
  </section>

  {/* ── Services ─────────────────────────────────────────── */}
  <section class="border-y border-hairline bg-paper-2">
    <div class="mx-auto max-w-[80rem] px-5 py-20 sm:px-8 sm:py-28">
      <div
        class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="eyebrow">What we do</p>
          <h2 class="mt-6 max-w-[16ch] font-display text-display text-ink">
            Five things, done properly.
          </h2>
        </div>
        <p class="max-w-sm text-[0.95rem] leading-relaxed text-ink-3">
          Every job runs the same way regardless of size: inspect, contain,
          agitate, extract, document.
        </p>
      </div>

      <ul class="mt-14">
        {
          services.map((s, i) => (
            <li>
              <a
                href={`/services/${s.id}`}
                class="group grid items-baseline gap-x-8 gap-y-3 border-t border-hairline py-8 transition-colors hover:bg-paper md:grid-cols-[auto_16rem_1fr_auto] md:py-9"
              >
                <span class="tnum font-display text-lg text-ink-4">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="flex items-center gap-3">
                  <ServiceIcon
                    name={s.data.icon}
                    class="size-6 shrink-0 text-brand-600"
                  />
                  <span class="font-display text-title text-ink">
                    {s.data.navLabel}
                  </span>
                </span>
                <span class="text-[0.95rem] leading-relaxed text-ink-3">
                  {s.data.summary}
                </span>
                <span class="text-brand-700 transition-transform group-hover:translate-x-1">
                  <svg
                    class="size-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 12h14m-6-6 6 6-6 6"
                    />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="border-t border-hairline"></div>
    </div>
  </section>

  {/* ── Why it matters ───────────────────────────────────── */}
  <section class="relative overflow-hidden bg-ink text-paper grain">
    <div
      class="relative z-10 mx-auto grid max-w-[80rem] gap-14 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2 lg:gap-20"
    >
      <div>
        <p class="eyebrow text-brand-300">Why it matters</p>
        <h2 class="mt-6 max-w-[18ch] font-display text-display optical-lg">
          You breathe about 11,000 litres of air a day. Most of it indoors.
        </h2>
        <p class="mt-7 max-w-lg text-lede text-paper/70">
          Americans spend something like 90% of their time inside, and the EPA
          has found indoor pollutant levels commonly run two to five times
          higher than outdoors. Your heating and air system is what moves that
          air around — through whatever has settled in the ductwork.
        </p>
        <p class="mt-5 max-w-lg text-[0.9rem] leading-relaxed text-mist">
          Duct cleaning is not a cure for allergies and we will not sell it to
          you as one. What it does is take the accumulated debris out of the
          path your air travels.
        </p>
      </div>

      <div class="rule-dark pt-8 lg:pt-0 lg:border-t-0">
        <h3 class="font-display text-title text-paper">
          Worth a look if any of these are true
        </h3>
        <ul class="mt-7 space-y-px">
          {
            [
              "Someone in the house has asthma, allergies or another respiratory condition",
              "There are indoor pets, or someone smokes inside",
              "A musty or stale smell shows up when the heat or air first kicks on",
              "Airflow from some registers is noticeably weaker than others",
              "The house was recently renovated, or you have just moved in",
              "Nobody knows when — or whether — the ducts were last cleaned",
            ].map((line) => (
              <li class="rule-dark flex gap-4 py-4">
                <svg
                  class="mt-1 size-4 shrink-0 text-brand-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 12.5 9.5 18 20 7"
                  />
                </svg>
                <span class="text-[0.95rem] leading-relaxed text-paper/80">
                  {line}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ── Process ──────────────────────────────────────────── */}
  <section class="mx-auto max-w-[80rem] px-5 py-20 sm:px-8 sm:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">Source removal</p>
      <h2 class="mt-6 font-display text-display text-ink">
        How a cleaning actually goes.
      </h2>
      <p class="mt-6 text-lede text-ink-2">
        Source removal means the contamination leaves the building rather than
        moving to a different part of it. It is the method NADCA's ACR Standard
        is built around, and it is the only one we use.
      </p>
    </div>

    <ol class="mt-14 grid gap-px border border-hairline bg-hairline md:grid-cols-2 lg:grid-cols-5">
      {
        process.map((step, i) => (
          <li class="bg-paper p-7">
            <span class="tnum font-display text-3xl text-ink-4">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 font-display text-xl leading-snug text-ink">
              {step.title}
            </h3>
            <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-3">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── Testimonial ──────────────────────────────────────── */}
  {
    lead && (
      <section class="border-y border-hairline bg-paper-2">
        <div class="mx-auto max-w-[80rem] px-5 py-20 sm:px-8 sm:py-28">
          <div class="grid gap-12 lg:grid-cols-[1fr_auto] lg:items-end">
            <figure class="max-w-4xl">
              <p class="eyebrow">In their words</p>
              <blockquote class="mt-7 font-display text-title leading-[1.35] text-ink">
                &ldquo;{lead.text}&rdquo;
              </blockquote>
              <figcaption class="mt-7 text-[0.9rem] text-ink-3">
                <span class="font-semibold text-ink">{lead.name}</span>
                <span class="mx-2 text-hairline">/</span>
                {lead.location_type}
              </figcaption>
            </figure>
            <a
              href="/testimonials"
              class="link-slide shrink-0 font-semibold text-brand-700"
            >
              Read {testimonials.length} reviews
            </a>
          </div>
        </div>
      </section>
    )
  }

  {/* ── Service areas ────────────────────────────────────── */}
  {
    areas.length > 0 && (
      <section class="mx-auto max-w-[80rem] px-5 py-20 sm:px-8 sm:py-28">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">Where we work</p>
            <h2 class="mt-6 max-w-[18ch] font-display text-display text-ink">
              Three offices, most of eastern North Carolina.
            </h2>
          </div>
        </div>

        <div class="mt-14 grid gap-px border border-hairline bg-hairline md:grid-cols-3">
          {areas.map((a) => {
            const office = site.offices.find(
              (o) => o.slug === a.data.officeSlug,
            );
            return (
              <a
                href={`/service-areas/${a.id}`}
                class="group bg-paper p-8 transition-colors hover:bg-paper-2"
              >
                <h3 class="font-display text-title text-ink">{a.data.city}</h3>
                <p class="mt-3 text-[0.92rem] leading-relaxed text-ink-3">
                  {a.data.summary}
                </p>
                {office && (
                  <p class="tnum mt-5 font-semibold text-brand-700">
                    {office.phone}
                  </p>
                )}
                <p class="mt-4 text-[0.82rem] leading-relaxed text-ink-4">
                  {a.data.towns.slice(0, 6).join(" · ")}
                  {a.data.towns.length > 6 && " …"}
                </p>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <CallToAction />
</Layout>
