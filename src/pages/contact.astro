---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const propertyTypes = [
  "Home",
  "Commercial building",
  "Industrial facility",
  "Medical or senior care",
  "Dryer vent only",
  "Not sure",
];
---

<Layout
  title="Contact"
  description="Call the Winterville shop, the Cary office or the Wilmington line, or send a message and we will come back within a business day."
>
  <PageHero
    eyebrow="Get in touch"
    title="Tell us about the building."
    lede="The more you tell us up front — how many systems, what you are noticing, when it was last done — the more useful the first conversation is."
  />

  <div
    class="mx-auto grid max-w-[80rem] gap-14 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1fr_22rem] lg:gap-20"
  >
    {/* ── Form ─────────────────────────────────────────── */}
    <div class="max-w-2xl">
      <form
        id="quote-form"
        method="POST"
        action={site.api.formHandler}
        class="space-y-6"
      >
        {/* Honeypots — bots fill these, people never see them. */}
        <div class="absolute left-[-9999px]" aria-hidden="true">
          <label>
            Website<input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
          <label>
            URL<input type="text" name="url" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="firstName" class="eyebrow eyebrow-plain block">
              First name
            </label>
            <input
              id="firstName"
              name="firstName"
              type="text"
              required
              autocomplete="given-name"
              class="mt-3 w-full rounded-xs border border-hairline bg-paper px-4 py-3.5 text-ink outline-none transition-colors focus:border-brand-600"
            />
          </div>
          <div>
            <label for="lastName" class="eyebrow eyebrow-plain block">
              Last name
            </label>
            <input
              id="lastName"
              name="lastName"
              type="text"
              required
              autocomplete="family-name"
              class="mt-3 w-full rounded-xs border border-hairline bg-paper px-4 py-3.5 text-ink outline-none transition-colors focus:border-brand-600"
            />
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="phone" class="eyebrow eyebrow-plain block">Phone</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              inputmode="tel"
              class="mt-3 w-full rounded-xs border border-hairline bg-paper px-4 py-3.5 text-ink outline-none transition-colors focus:border-brand-600"
            />
          </div>
          <div>
            <label for="email" class="eyebrow eyebrow-plain block">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-3 w-full rounded-xs border border-hairline bg-paper px-4 py-3.5 text-ink outline-none transition-colors focus:border-brand-600"
            />
          </div>
        </div>

        <div>
          <label for="propertyType" class="eyebrow eyebrow-plain block">
            What kind of property
          </label>
          <select
            id="propertyType"
            name="propertyType"
            class="mt-3 w-full rounded-xs border border-hairline bg-paper px-4 py-3.5 text-ink outline-none transition-colors focus:border-brand-600"
          >
            {propertyTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>

        <div>
          <label for="message" class="eyebrow eyebrow-plain block">
            What is going on
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="How many heating and air systems, roughly how old the house is, and what made you start looking into this."
            class="mt-3 w-full rounded-xs border border-hairline bg-paper px-4 py-3.5 text-ink outline-none transition-colors placeholder:text-ink-4 focus:border-brand-600"
          ></textarea>
        </div>

        <p
          id="form-status"
          role="status"
          aria-live="polite"
          class="hidden rounded-xs border px-4 py-3.5 text-[0.9rem] font-medium"
        >
        </p>

        <button
          type="submit"
          id="form-submit"
          class="w-full rounded-xs bg-brand-600 px-8 py-4 font-semibold text-white transition-colors hover:bg-brand-700 disabled:opacity-60 sm:w-auto"
        >
          Send it
        </button>

        <p class="text-[0.82rem] leading-relaxed text-ink-3">
          We answer within a business day. If it is urgent, ring the shop —
          somebody actually picks up.
        </p>
      </form>
    </div>

    {/* ── Direct contact ───────────────────────────────── */}
    <aside>
      <div class="border border-hairline bg-paper-2 p-7">
        <h2 class="eyebrow eyebrow-plain">Book straight in</h2>
        <div class="mt-5 space-y-2.5">
          <a
            href={site.booking.freeInspection}
            class="block rounded-xs bg-brand-600 px-5 py-3.5 text-center text-[0.92rem] font-semibold text-white transition-colors hover:bg-brand-700"
          >
            Free inspection
          </a>
          <a
            href={site.booking.dryerVent}
            class="block rounded-xs border border-ink/20 px-5 py-3.5 text-center text-[0.92rem] font-semibold text-ink transition-colors hover:border-ink/50"
          >
            Dryer vent cleaning
          </a>
          <a
            href={site.booking.commercial}
            class="block rounded-xs border border-ink/20 px-5 py-3.5 text-center text-[0.92rem] font-semibold text-ink transition-colors hover:border-ink/50"
          >
            Commercial consultation
          </a>
        </div>
      </div>

      <div class="mt-6 space-y-px border border-hairline bg-hairline">
        {
          site.offices.map((o) => (
            <div class="bg-paper p-6">
              <p class="text-[0.78rem] uppercase tracking-[0.12em] text-ink-4">
                {o.role}
              </p>
              <h3 class="mt-1.5 font-display text-lg text-ink">{o.name}</h3>
              <a
                href={o.phoneHref}
                class="tnum mt-2 block font-display text-2xl text-brand-700"
              >
                {o.phone}
              </a>
              {o.mapUrl ? (
                <a
                  href={o.mapUrl}
                  rel="noopener"
                  class="link-slide mt-2 inline-block text-[0.85rem] leading-snug text-ink-3"
                >
                  {o.street}, {o.city}
                </a>
              ) : (
                <p class="mt-2 text-[0.85rem] leading-snug text-ink-3">
                  {o.street}
                </p>
              )}
            </div>
          ))
        }
        <div class="bg-paper p-6">
          <p class="text-[0.78rem] uppercase tracking-[0.12em] text-ink-4">
            Email
          </p>
          <a
            href={`mailto:${site.email}`}
            class="link-slide mt-2 inline-block text-[0.95rem] font-semibold text-ink"
          >
            {site.email}
          </a>
        </div>
      </div>
    </aside>
  </div>
</Layout>

<script>
  // Progressive enhancement only: without this the form still posts
  // normally to the Worker. With it, the visitor stays on the page.
  const form = document.querySelector<HTMLFormElement>("#quote-form");
  const status = document.querySelector<HTMLParagraphElement>("#form-status");
  const button = document.querySelector<HTMLButtonElement>("#form-submit");

  if (form && status && button) {
    const show = (message: string, ok: boolean) => {
      status.textContent = message;
      status.className = ok
        ? "rounded-xs border border-verify-600/40 bg-verify-100 px-4 py-3.5 text-[0.9rem] font-medium text-verify-700"
        : "rounded-xs border border-brand-600/40 bg-brand-100 px-4 py-3.5 text-[0.9rem] font-medium text-brand-700";
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      const original = button.textContent;
      button.textContent = "Sending…";
      status.className = "hidden";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
        });
        const data = await response.json().catch(() => ({}));

        if (response.ok) {
          show(
            data.message ?? "Got it. We will be in touch within a business day.",
            true,
          );
          form.reset();
        } else {
          show(
            data.error ?? "That did not go through. Please ring 252-321-7447.",
            false,
          );
        }
      } catch {
        show(
          "Could not reach the server. Please ring 252-321-7447 and we will sort it out.",
          false,
        );
      }

      button.disabled = false;
      button.textContent = original;
    });
  }
</script>
